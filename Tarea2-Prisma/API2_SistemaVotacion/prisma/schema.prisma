// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Encuesta {
  id        Int      @id @default(autoincrement())
  pregunta  String
  opciones  Opcion[]
}

model Opcion {
  id         Int      @id @default(autoincrement())
  opcion     String
  votos      Int      @default(0)

  encuestaId Int
  encuesta   Encuesta @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
}

model Inventario {
  id          Int    @id @default(autoincrement())
  producto    String
  stock       Int
  stockMinimo Int     @default(5)
}

model Turno {
  id       Int          @id @default(autoincrement())
  cliente  String
  servicio String
  estado   EstadoTurno
}

enum EstadoTurno {
  esperando
  atendiendo
  finalizado
}

model Habito {
  id        Int              @id @default(autoincrement())
  nombre    String
  meta      String
  registros RegistroHabito[]
}

model RegistroHabito {
  id         Int      @id @default(autoincrement())
  fecha      DateTime
  completado Boolean
  habitoId   Int
  habito     Habito   @relation(fields: [habitoId], references: [id], onDelete: Cascade)
}